
                                                       
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
		"source": "~/.config/fastfetch/smol_mizu_without_text.txt",
	    "height": 14,
	    "padding": {
		    "top": 1
	    },
	    "color": {"9": "#d74894"}
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10,
	    "color": {
	    	"user": "white",
		"at": "37",
		"host": "white"
	    }
        },
        {
            "type": "custom",
            "format": "~~~~~~~~~~~~~~~~~~~~~~~~~~",
        },
        {
            "type": "os",
            "key": "~ ",
            "keyColor": "white",
        },
        {
            "type": "kernel",
            "key": "~ ",
            "keyColor": "white",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "~ ",
            "keyColor": "white",  
        },
        {
            "type": "shell",
            "key": "~ ",
            "keyColor": "white", 
        },
        {
            "type": "terminal",
            "key": "~ ",
            "keyColor": "white", 
        },
        {
            "type": "wm",
            "key": "~ ",
            "keyColor": "white", 
        },
        {
            "type": "uptime",
            "key": "~ ",
            "keyColor": "white", 
        },
        {
            "type": "media",
            "key": "~ ",
            "keyColor": "white", 
        },
        "break",
    ]
}
